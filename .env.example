# ── Strava API credentials ────────────────────────────────────────────────────
# Create your app at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Obtain via: python auth.py
# After first run, the token is stored in the SQLite config table and auto-rotated.
STRAVA_REFRESH_TOKEN=your_initial_refresh_token_here

# ── GeoVelo (optional) ────────────────────────────────────────────────────────
# Required only if you use geovelo_sync.py.
# Run geovelo_init_db.py once before first use.
#
# GEOVELO_AUTHENTIFICATION: base64 encoding of "your_email;your_password"
# Generate it with:
#   python -c "import base64; print(base64.b64encode(b'email@example.com;yourpassword').decode())"
GEOVELO_AUTHENTIFICATION=
GEOVELO_API_KEY=0f8c781a-b4b4-4d19-b931-1e82f22e769f
GEOVELO_SOURCE=website
